# Provider: "requesty" (default for this setup), "anthropic" or "openai"
AI_PROVIDER=requesty

# Requesty (OpenAI-compatible gateway, https://router.requesty.ai/v1)
REQUESTY_API_KEY=

# Direct provider keys (only needed when AI_PROVIDER is anthropic/openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the model id.
# Requesty uses provider/model format, e.g. "anthropic/claude-haiku-4-5" (default)
# Direct defaults: claude-haiku-4-5 (anthropic) / gpt-4o-mini (openai)
MODEL=
